// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Auth (NextAuth / Auth.js adapter shape) ----------

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         String    @default("customer") // "customer" | "admin"
  addresses    Address[]
  orders       Order[]
  accounts     Account[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Catalog ----------

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Collection {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  heroImage String?
  products  ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Product {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  description    String
  priceCents     Int
  compareAtCents Int?
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  collections    ProductCollection[]
  reviews        Review[]
  isFeatured     Boolean             @default(false)
  isPublished    Boolean             @default(true)
  createdAt      DateTime            @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  color      String
  colorHex   String?
  sku        String      @unique
  priceCents Int?
  inventory  Int         @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

// ---------- Cart (server model reserved for future sync; v1 cart is client-only Zustand) ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

// ---------- Orders ----------

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  status          String      @default("pending") // pending | paid | fulfilled | cancelled
  stripeSessionId String?     @unique
  subtotalCents   Int
  shippingCents   Int         @default(0)
  taxCents        Int         @default(0)
  totalCents      Int
  shippingAddress String // JSON snapshot, not FK
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  unitPriceCents Int
  quantity       Int
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  isDefault  Boolean @default(false)
}

// P1 — add once the core P0 flow is verified end to end
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())
}

// ---------- Custom embroidery reference catalogs ----------
// Options customers browse when placing a custom embroidery order. One
// shared shape across catalog types (rather than 4 near-identical models):
// catalog: "thread-colors" | "fonts" | "monogram-styles" | "designs"
model ReferenceCatalogItem {
  id          String   @id @default(cuid())
  catalog     String
  name        String
  description String?
  swatchHex   String? // thread-colors only: renders a color swatch before a photo exists
  imageUrl    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([catalog, name])
}

// A configured custom-embroidery design submitted for a human quote/review —
// not an instant checkout line item, since price depends on text length,
// thread count, and design complexity. Selections are snapshotted as plain
// strings (not FKs) so a later catalog edit never changes a past request,
// matching the Order/OrderItem snapshot pattern above.
model CustomOrderRequest {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  productName       String?
  productSlug       String?
  variantLabel      String?
  placement         String?
  monogramText      String?
  fontName          String?
  monogramStyleName String?
  designName        String?
  threadColorName   String?
  logoUrl           String? // customer-uploaded artwork, saved under public/uploads
  basePriceCents    Int? // snapshot of the base product's price shown at submission time
  notes             String?
  status            String   @default("new") // "new" | "reviewed" | "closed"
  createdAt         DateTime @default(now())
}
