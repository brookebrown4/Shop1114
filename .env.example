# SQLite by default — zero setup required for local dev
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Stripe TEST MODE keys only — https://dashboard.stripe.com/test/apikeys
# Never put live (sk_live_/pk_live_) keys here
STRIPE_SECRET_KEY=""
# For local dev, run `stripe listen --forward-to localhost:3002/api/webhooks/stripe`
# and paste the "whsec_..." it prints here.
STRIPE_WEBHOOK_SECRET=""

# Resend — https://resend.com/api-keys (free tier, no card required)
RESEND_API_KEY=""
# Sandbox default; without your own verified domain on Resend, "from" must
# stay onboarding@resend.dev and "to" can only be the email you signed up
# with — see https://resend.com/docs/dashboard/domains/introduction
EMAIL_FROM="onboarding@resend.dev"
# Where admin new-order notifications are sent. Must be a real inbox you can
# check — while unverified on Resend, this ALSO has to be the email address
# you signed up to Resend with, or sends to it will be rejected.
ADMIN_EMAIL="admin@shop1114.test"
